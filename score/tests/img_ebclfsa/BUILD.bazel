load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//score/common/img_ebclfsa:defs.bzl", "img_ebclfsa_extract")
load("//score/common/img_edit:defs.bzl", "img_edit")

py_binary(
    name = "make_release",
    srcs = ["make_release.py"],
    main = "make_release.py",
)

genrule(
    name = "release_archive",
    outs = ["release.tar.gz"],
    cmd = "$(location :make_release) $@",
    tools = [":make_release"],
)

img_ebclfsa_extract(
    name = "extracted",
    archive = ":release_archive",
)

pkg_tar(
    name = "payload_tar",
    srcs = glob(["payload/**/*"]),
    package_dir = "/opt",
    strip_prefix = "payload",
)

img_edit(
    name = "edited",
    srcs = [":payload_tar"],
    image = ":extracted",
)

py_test(
    name = "extract_and_edit_test",
    srcs = ["test_extract_and_edit.py"],
    data = [
        ":edited",
        ":extracted.wic",
        ":extracted-ssh-key",
        ":extracted-vmlinux",
    ],
    main = "test_extract_and_edit.py",
)
