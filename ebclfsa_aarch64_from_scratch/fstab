# Persistent data partition
LABEL=data      /data           auto        defaults        0 2

# Additional disk attached by the ITF QEMU plugin
/dev/vdb        /opt            auto        defaults,nofail 0 0

# Temporary and pseudofilesystems
none            /sys/fs/cgroup  cgroup2     defaults        0 0
none            /var/log        tmpfs       defaults        0 0
none            /dev/shm        tmpfs       defaults        0 0
